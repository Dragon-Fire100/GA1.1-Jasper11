    "def my_function(a,b):\n",
    "    c = a + b\n",
    "    return c\n",
    "\n",
    "def repeat_add(a):\n",
    "    i = 0\n",
    "    d = 0\n",
    "    while i < len(a):\n",
    "        d = my_function(a[i],d)\n",
    "        i += 1\n",
    "    return(d)\n",
    "\n",
    "print(str(repeat_add([1,2,3])))\n",
    "print(str(repeat_add([2,3,4])))\n",
    "print(str(repeat_add([3,4,5])))"
   ]
  },
